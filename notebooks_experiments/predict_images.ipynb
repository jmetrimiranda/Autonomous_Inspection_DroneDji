     "text": [
      "Encontradas 4 imagens para inspecionar.\n",
      "\n",
      "0: 576x1024 2 Failuress, 12.9ms\n",
      "1: 576x1024 4 Failuress, 12.9ms\n",
      "2: 576x1024 4 Failuress, 12.9ms\n",
      "3: 576x1024 4 Failuress, 12.9ms\n",
      "Speed: 2.8ms preprocess, 12.9ms inference, 2.2ms postprocess per image at shape (1, 3, 576, 1024)\n",
      "Results saved to \u001b[1m/home/jorgemetri/Desktop/Autonomous_Inspection_DroneDji/notebooks_experiments/runs/detect/Inspecao_Avarias/Teste_Imagens_Input\u001b[0m\n",
      "Inspecao concluida! Verifique a pasta Teste_Imagens_Input.\n"
     ]
    }
   ],
   "source": [
    "import os\n",
    "import glob\n",
    "from ultralytics import YOLO\n",
    "\n",
    "# Caminho para o melhor peso do seu treinamento recente\n",
    "model_path = r\"/home/jorgemetri/Desktop/Autonomous_Inspection_DroneDji/yolo_training/src/runs/detect/Inspecao_Avarias/YOLO26_Medium_1024/weights/best.pt\"\n",
    "\n",
    "# Carrega o modelo customizado\n",
    "model = YOLO(model_path)\n",
    "\n",
    "# Defina a pasta onde estão as imagens a serem testadas\n",
    "pasta_imagens = r\"/home/jorgemetri/Desktop/Autonomous_Inspection_DroneDji/presentation/assets\" # Ajuste para a sua pasta real\n",
    "\n",
    "# Busca todos os arquivos que começam com \"input\" (ex: input_01.jpg, input_fissura.png)\n",
    "padrao_busca = os.path.join(pasta_imagens, \"input*.*\")\n",
    "imagens_para_processar = glob.glob(padrao_busca)\n",
    "\n",
    "if imagens_para_processar:\n",
    "    print(f\"Encontradas {len(imagens_para_processar)} imagens para inspecionar.\")\n",
    "    \n",
    "    # Roda a inferência. O parâmetro save=True salva as imagens com as caixas desenhadas.\n",
    "    resultados = model.predict(\n",
    "        source=imagens_para_processar, \n",
    "        imgsz=1024, \n",
    "        conf=0.5, # Filtra detecções com menos de 50% de confiança\n",
    "        save=True, \n",
    "        project=\"Inspecao_Avarias\",\n",
    "        name=\"Teste_Imagens_Input\"\n",
    "    )\n",
    "    print(\"Inspecao concluida! Verifique a pasta Teste_Imagens_Input.\")\n",
    "else:\n",
    "    print(f\"Nenhuma imagem com o prefixo 'input' foi encontrada em: {pasta_imagens}\")"
   ]
  },
